<script>
/* =====================================================================
   CONFIGURAÇÃO — é só preencher aqui.
   Pastas sugeridas: images/hero/ para fotos e prints, videos/ para vídeos.
   ===================================================================== */

// FAIXA DE CIMA — antes/depois (fotos com o MESMO tamanho e enquadramento, vertical 4:5, ex.: 800×1000)
var HC_ANTES_DEPOIS = [
	/*
	{ nome:'Maria S.', idade:54, semanas:4, antes:'images/hero/maria-antes.webp', depois:'images/hero/maria-depois.webp' },
	{ nome:'Ana R.',   idade:61, semanas:6, antes:'images/hero/ana-antes.webp',   depois:'images/hero/ana-depois.webp' },
	*/
];

// FAIXA DE BAIXO — depoimentos. Três tipos:
//   texto → { tipo:'texto', nome:'Ana R.', idade:58, local:'Braga', foto:'images/hero/ana.webp', texto:'O que ela escreveu.', estrelas:5 }
//   print → { tipo:'print', imagem:'images/hero/print-whatsapp-1.webp', legenda:'Ana, 58 anos' }
//   vídeo → { tipo:'video', video:'videos/dep-ana.mp4', poster:'images/hero/ana-capa.webp', nome:'Ana R.', idade:58 }
var HC_DEPOIMENTOS = [
	/*
	{ tipo:'texto', nome:'Ana R.', idade:58, local:'Braga', foto:'images/hero/ana.webp', texto:'Escreva aqui a mensagem real da aluna.', estrelas:5 },
	{ tipo:'print', imagem:'images/hero/print-1.webp', legenda:'Teresa, 52 anos' },
	{ tipo:'video', video:'videos/dep-1.mp4', poster:'images/hero/dep-1-capa.webp', nome:'Rosa M.', idade:63 },
	*/
];

var HC_VELOCIDADE = 26;        // píxeis por segundo (0 = sem movimento automático)
var HC_ESPACOS_EDICAO = 6;     // nº de espaços vazios por faixa em modo edição
/* ===================================================================== */

(function(){
	var raiz = document.getElementById('hc-carrossel'); if (!raiz) return;
	var q = new URLSearchParams(location.search);
	var EDICAO = location.protocol === 'file:' || /^(localhost|127\.0\.0\.1)$/.test(location.hostname) || q.has('editar');
	var reduzir = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
	var rato = window.matchMedia && matchMedia('(hover: hover) and (pointer: fine)').matches;
	function esc(t){ return String(t == null ? '' : t).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
	function dl(o){ window.dataLayer = window.dataLayer || []; window.dataLayer.push(o); }
	function nomeIdade(x){ return esc(x.nome || '') + (x.idade ? ', ' + esc(x.idade) : ''); }

	var ad  = (window.HC_ANTES_DEPOIS || []).filter(function(x){ return x && x.antes && x.depois; });
	var dep = (window.HC_DEPOIMENTOS  || []).filter(function(x){ return x && (x.texto || x.imagem || x.video); });
	var vagas = EDICAO ? (window.HC_ESPACOS_EDICAO || 6) : 0;
	var adSlots = Math.max(0, vagas - ad.length), depSlots = Math.max(0, vagas - dep.length);
	if (!ad.length && !dep.length && !EDICAO) { raiz.hidden = true; return; }

	/* ---------- construtores de cartões ---------- */
	var nCard = 0;
	function cartaoAD(x){
		var i = nCard++;
		var f = document.createElement('figure'); f.className = 'hc-card hc-ad';
		var carga = i < 4 ? 'eager' : 'lazy';
		f.innerHTML =
			'<div class="hc-palco hc-respira" style="animation-delay:-' + ((i * 1.1) % 4.4).toFixed(1) + 's">' +
				'<img src="' + esc(x.antes) + '" alt="Antes — ' + nomeIdade(x) + '" loading="' + carga + '" decoding="async" draggable="false">' +
				'<img class="hc-depois" src="' + esc(x.depois) + '" alt="Depois — ' + nomeIdade(x) + '" loading="' + carga + '" decoding="async" draggable="false">' +
				'<span class="hc-tag a">Antes</span><span class="hc-tag d">Depois</span>' +
				'<span class="hc-traco"></span>' +
				'<span class="hc-pega" role="slider" tabindex="0" aria-label="Comparar antes e depois" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">‹›</span>' +
			'</div>' +
			'<figcaption class="hc-legenda"><b>' + nomeIdade(x) + '</b>' + (x.semanas ? '<span>' + esc(x.semanas) + (x.semanas == 1 ? ' semana' : ' semanas') + '</span>' : '') + '</figcaption>';
		return f;
	}
	function cartaoDep(x){
		var f;
		if (x.tipo === 'video' && x.video) {
			f = document.createElement('figure'); f.className = 'hc-card hc-video';
			f.innerHTML = '<div class="hc-video-box"><video muted loop playsinline preload="metadata" src="' + esc(x.video) + '"' + (x.poster ? ' poster="' + esc(x.poster) + '"' : '') + '></video>' +
				'<span class="hc-video-nome">' + nomeIdade(x) + '</span><button type="button" class="hc-som" aria-label="Ligar o som">🔇</button></div>';
		} else if (x.tipo === 'print' || (!x.texto && x.imagem)) {
			f = document.createElement('figure'); f.className = 'hc-card hc-print';
			f.innerHTML = '<img src="' + esc(x.imagem) + '" alt="Mensagem de aluna' + (x.legenda ? ' — ' + esc(x.legenda) : '') + '" loading="lazy" decoding="async" draggable="false">' +
				(x.legenda ? '<figcaption>' + esc(x.legenda) + '</figcaption>' : '');
		} else {
			f = document.createElement('figure'); f.className = 'hc-card hc-dep';
			var est = x.estrelas ? '<div class="hc-estrelas" aria-label="' + esc(x.estrelas) + ' estrelas">' + '★★★★★'.slice(0, Math.min(5, x.estrelas)) + '</div>' : '';
			f.innerHTML = est + '<blockquote>“' + esc(x.texto) + '”</blockquote>' +
				'<figcaption class="hc-autor">' + (x.foto ? '<img src="' + esc(x.foto) + '" alt="" loading="lazy" decoding="async">' : '') +
				'<div><b>' + nomeIdade(x) + '</b>' + (x.local ? '<span>' + esc(x.local) + '</span>' : '') + '</div></figcaption>';
		}
		return f;
	}
	function slot(tipo, n){
		var f = document.createElement('figure');
		var m = {
			ad:    ['hc-ad',    '🖼️', 'Antes/depois ' + n, 'Foto antes + depois, mesmo tamanho (4:5).', 'HC_ANTES_DEPOIS'],
			texto: ['hc-dep',   '💬', 'Depoimento ' + n,   'Texto real + nome, idade e foto.',           'HC_DEPOIMENTOS'],
			print: ['hc-print', '📱', 'Print ' + n,        'Print de WhatsApp, e-mail ou Instagram.',     'HC_DEPOIMENTOS'],
			video: ['hc-video', '🎥', 'Vídeo ' + n,        'Vídeo vertical 9:16 com capa.',               'HC_DEPOIMENTOS']
		}[tipo];
		f.className = 'hc-card ' + m[0];
		f.innerHTML = '<div class="hc-slot"><span aria-hidden="true">' + m[1] + '</span><b>' + m[2] + '</b><small>' + m[3] + '</small><code>' + m[4] + '</code></div>';
		return f;
	}

	/* ---------- montar cada faixa (com loop infinito) ---------- */
	function montar(linhaEl, itens, fabricar){
		var trilho = linhaEl.querySelector('.hc-trilho');
		if (!itens.length) { linhaEl.hidden = true; return null; }
		// repete o conjunto até encher a largura, depois duplica para o loop
		var base = itens.slice(), conjunto = base.slice(), tent = 0;
		function larguraEstimada(lista){ var t = 0; lista.forEach(function(it){ t += (it.__w || 240) + 14; }); return t; }
		var alvo = Math.max(trilho.clientWidth || window.innerWidth, 360) * 1.15;
		while (larguraEstimada(conjunto) < alvo && tent < 8) { conjunto = conjunto.concat(base); tent++; }
		var voltas = itens.length > 1 || tent > 0 ? 2 : 1;
		for (var v = 0; v < voltas; v++) conjunto.forEach(function(it){ trilho.appendChild(fabricar(it)); });
		return { trilho: trilho, voltas: voltas, tamanhoConjunto: conjunto.length };
	}

	var itensAD = ad.map(function(x){ x.__w = 210; return {d:x}; });
	for (var a = 0; a < adSlots; a++) itensAD.push({slot:'ad', n: ad.length + a + 1, __w:210});
	var tiposSlot = ['texto','print','video'];
	var itensDep = dep.map(function(x){ return {d:x, __w: x.tipo === 'video' ? 190 : (x.tipo === 'print' ? 230 : 290)}; });
	for (var d = 0; d < depSlots; d++) { var t = tiposSlot[d % 3]; itensDep.push({slot:t, n: dep.length + d + 1, __w: t === 'video' ? 190 : (t === 'print' ? 230 : 290)}); }

	var linhaAD = raiz.querySelector('[data-linha="ad"]'), linhaDep = raiz.querySelector('[data-linha="dep"]');
	var faixas = [
		montar(linhaAD,  itensAD,  function(it){ return it.slot ? slot(it.slot, it.n) : cartaoAD(it.d); }),
		montar(linhaDep, itensDep, function(it){ return it.slot ? slot(it.slot, it.n) : cartaoDep(it.d); })
	].filter(Boolean);
	if (!faixas.length) { raiz.hidden = true; return; }

	/* ---------- comparadores antes/depois ---------- */
	raiz.querySelectorAll('.hc-palco').forEach(function(palco){
		var pega = palco.querySelector('.hc-pega'), usado = false;
		var trilho = palco.closest('.hc-trilho');
		function setPos(x){ x = Math.max(0, Math.min(100, x)); palco.style.setProperty('--hcpos', x + '%'); pega.setAttribute('aria-valuenow', Math.round(x)); }
		function assumir(){
			if (palco.classList.contains('hc-respira')) {
				var atual = getComputedStyle(palco).getPropertyValue('--hcpos');
				palco.classList.remove('hc-respira'); palco.style.setProperty('--hcpos', atual || '50%');
			}
			if (!usado) { usado = true; dl({event:'hc_comparar'}); }
		}
		function xDe(e){ var r = palco.getBoundingClientRect(); return (e.clientX - r.left) / r.width * 100; }
		pega.addEventListener('pointerdown', function(e){
			e.preventDefault(); e.stopPropagation(); assumir(); pausar(trilho, 6000);
			palco.classList.remove('hc-anima'); pega.setPointerCapture(e.pointerId);
			function mover(ev){ setPos(xDe(ev)); }
			function soltar(){ pega.removeEventListener('pointermove', mover); pega.removeEventListener('pointerup', soltar); pega.removeEventListener('pointercancel', soltar); }
			pega.addEventListener('pointermove', mover); pega.addEventListener('pointerup', soltar); pega.addEventListener('pointercancel', soltar);
		});
		pega.addEventListener('keydown', function(e){
			if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
			e.preventDefault(); assumir(); pausar(trilho, 6000);
			var atual = parseFloat(getComputedStyle(palco).getPropertyValue('--hcpos')) || 50;
			setPos(atual + (e.key === 'ArrowLeft' ? -5 : 5));
		});
		if (rato) {
			palco.addEventListener('pointermove', function(e){ if (e.pointerType !== 'mouse' || trilho.classList.contains('hc-arrasta')) return; assumir(); palco.classList.remove('hc-anima'); setPos(xDe(e)); });
			palco.addEventListener('pointerleave', function(){ if (!usado) return; palco.classList.add('hc-anima'); setPos(50); });
		}
		palco.addEventListener('click', function(e){
			if (e.target === pega || trilho.dataset.arrastou === '1') return;
			assumir(); pausar(trilho, 6000); palco.classList.add('hc-anima');
			var atual = parseFloat(getComputedStyle(palco).getPropertyValue('--hcpos')) || 50;
			setPos(atual > 50 ? 0 : 100);
		});
	});

	/* ---------- vídeos: tocam sem som quando estão à vista ---------- */
	raiz.querySelectorAll('.hc-video video').forEach(function(v){
		var btn = v.parentNode.querySelector('.hc-som');
		btn.addEventListener('click', function(e){
			e.stopPropagation();
			raiz.querySelectorAll('.hc-video video').forEach(function(o){ if (o !== v) { o.muted = true; var b = o.parentNode.querySelector('.hc-som'); b.textContent = '🔇'; } });
			v.muted = !v.muted; btn.textContent = v.muted ? '🔇' : '🔊'; btn.setAttribute('aria-label', v.muted ? 'Ligar o som' : 'Desligar o som');
			if (!v.muted) { v.play().catch(function(){}); pausar(v.closest('.hc-trilho'), 15000); dl({event:'hc_video_som'}); }
		});
		if ('IntersectionObserver' in window) {
			new IntersectionObserver(function(en){ en.forEach(function(x){ if (x.isIntersecting) v.play().catch(function(){}); else v.pause(); }); }, {threshold:.6}).observe(v);
		}
	});

	/* ---------- destaque dos cartões bem à vista ---------- */
	faixas.forEach(function(f){
		var cards = f.trilho.querySelectorAll('.hc-card');
		if ('IntersectionObserver' in window && !reduzir) {
			var io = new IntersectionObserver(function(en){ en.forEach(function(x){ x.target.classList.toggle('hc-on', x.intersectionRatio >= .62); }); }, {root: f.trilho, threshold:[0,.62,1]});
			cards.forEach(function(c){ io.observe(c); });
		} else cards.forEach(function(c){ c.classList.add('hc-on'); });
	});

	/* ---------- movimento automático + loop + arrastar ---------- */
	var vel = reduzir ? 0 : (typeof HC_VELOCIDADE === 'number' ? HC_VELOCIDADE : 26);
	var estado = new Map();
	function pausar(trilho, ms){ var s = estado.get(trilho); if (s) s.ate = performance.now() + (ms || 5000); }

	faixas.forEach(function(f){
		var tr = f.trilho, dir = parseInt(tr.getAttribute('data-dir'), 10) || 1;
		var s = {ate: 0, resto: 0, visivel: true, dir: dir, voltas: f.voltas, metade: 0};
		estado.set(tr, s);
		function medirMetade(){
			if (s.voltas < 2) { s.metade = 0; return; }
			var cards = tr.querySelectorAll('.hc-card');
			var a = cards[0], b = cards[f.tamanhoConjunto];
			s.metade = (a && b) ? (b.offsetLeft - a.offsetLeft) : tr.scrollWidth / 2;
		}
		medirMetade(); window.addEventListener('resize', medirMetade);
		tr.addEventListener('scroll', function(){
			if (!s.metade) return;
			if (tr.scrollLeft >= s.metade + 1) tr.scrollLeft -= s.metade;
			else if (tr.scrollLeft <= 0) tr.scrollLeft += s.metade;
		}, {passive:true});
		// posição inicial (a faixa que anda para a esquerda começa a meio)
		requestAnimationFrame(function(){ medirMetade(); tr.scrollLeft = dir < 0 && s.metade ? s.metade - 1 : 1; });

		tr.addEventListener('pointerenter', function(e){ if (e.pointerType === 'mouse') s.ate = Infinity; });
		tr.addEventListener('pointerleave', function(e){ if (e.pointerType === 'mouse') s.ate = performance.now() + 1200; });
		tr.addEventListener('touchstart', function(){ pausar(tr, 6000); }, {passive:true});
		tr.addEventListener('wheel', function(){ pausar(tr, 4000); }, {passive:true});
		tr.addEventListener('focusin', function(){ s.ate = Infinity; });
		tr.addEventListener('focusout', function(){ pausar(tr, 1500); });
		if ('IntersectionObserver' in window) new IntersectionObserver(function(en){ s.visivel = en[0].isIntersecting; }).observe(tr);

		// arrastar com o rato (desktop)
		var ini = null;
		tr.addEventListener('pointerdown', function(e){
			if (e.pointerType !== 'mouse' || e.target.closest('.hc-pega, .hc-som, video')) return;
			ini = {x: e.clientX, s: tr.scrollLeft}; tr.dataset.arrastou = '0';
		});
		window.addEventListener('pointermove', function(e){
			if (!ini) return;
			var dx = e.clientX - ini.x;
			if (Math.abs(dx) > 6) { tr.dataset.arrastou = '1'; tr.classList.add('hc-arrasta'); pausar(tr, 5000); }
			if (tr.dataset.arrastou === '1') tr.scrollLeft = ini.s - dx;
		});
		window.addEventListener('pointerup', function(){
			if (!ini) return; ini = null; tr.classList.remove('hc-arrasta');
			setTimeout(function(){ tr.dataset.arrastou = '0'; }, 50);
		});
	});

	var ultimo = 0;
	function passo(t){
		var dt = ultimo ? Math.min(64, t - ultimo) : 16; ultimo = t;
		if (vel) estado.forEach(function(s, tr){
			if (!s.visivel || t < s.ate || s.voltas < 2) return;
			s.resto += vel * dt / 1000;
			var px = Math.floor(s.resto);
			if (px >= 1) { s.resto -= px; tr.scrollLeft += px * s.dir; }
		});
		requestAnimationFrame(passo);
	}
	requestAnimationFrame(passo);
})();
</script>
